<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="CSV-Anlieferung"><l:main-panel>
    <h1>CSV-Anlieferung</h1>
    <j:if test="${!it.processingReady}"><p>Die CSV-Verarbeitung ist noch nicht verfügbar.</p></j:if>
    <form method="get" action="${rootURL}/anlieferung/">
      <label>Datensätze suchen <input name="search" value="${request.getAttribute('search')}" maxlength="100"/></label>
      <button type="submit" class="jenkins-button">Suchen</button>
    </form>
    <j:forEach var="row" items="${request.getAttribute('eligible')}">
      <section class="jenkins-card">
        <h2>${row.title()}</h2><p>Ausgabe ${row.issueKey()}</p>
        <j:if test="${it.processingReady}">
          <form class="no-json di-upload" method="post" data-endpoint="${rootURL}/anlieferung/upload"
                data-crumb-field="${it.crumbField}" data-crumb="${it.crumb}"
                data-dataset="${row.datasetId()}" data-issue="${row.issueId()}">
            <label>Liefermodus <select name="mode">
              <j:forEach var="mode" items="${row.modes()}"><option value="${mode}"><j:choose><j:when test="${mode == 'replace'}">Vollständiger Ersatz</j:when><j:otherwise>Ergänzen</j:otherwise></j:choose></option></j:forEach>
            </select></label>
            <label>CSV-Datei <input name="file" type="file" accept=".csv,text/csv" required="required"/></label>
            <button type="submit" class="jenkins-button">CSV einreichen</button>
            <p role="status" aria-live="polite"></p>
          </form>
        </j:if>
      </section>
    </j:forEach>
    <script src="${rootURL}/plugin/jenkins-gretl-dateninfrastruktur-plugin/js/delivery-upload.js" defer="defer"></script>
  </l:main-panel></l:layout>
</j:jelly>
