<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="Lieferung nicht möglich"><l:main-panel>
    <h1>Lieferung nicht möglich</h1><p>${request.getAttribute('problem')}</p>
    <j:if test="${request.getAttribute('loginRequired')}"><p><a href="${rootURL}/securityRealm/commenceLogin?from=${rootURL}/anlieferung/">Erneut über Keycloak anmelden</a></p></j:if>
    <p><a href="${rootURL}/anlieferung/">Zur Übersicht</a></p>
  </l:main-panel></l:layout>
</j:jelly>
