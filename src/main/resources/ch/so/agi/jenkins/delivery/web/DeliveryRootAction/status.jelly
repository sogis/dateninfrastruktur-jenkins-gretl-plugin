<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <j:set var="row" value="${request.getAttribute('delivery')}"/>
  <l:layout title="Lieferstatus"><l:main-panel>
    <h1>Lieferstatus</h1>
    <p id="di-delivery-state">${it.stateLabel(row.status())}</p>
    <dl><dt>Lieferkennung</dt><dd>${row.id()}</dd><dt>Dateigrösse</dt><dd>${row.inputSize()}</dd></dl>
    <j:if test="${row.acceptedVersionId() != null}">
      <p>Angenommene Version ${row.acceptedVersionId()}</p>
    </j:if>
    <p><a href="?id=${row.id()}">Status aktualisieren</a></p>
    <p><a href="${rootURL}/anlieferung/">Zur Übersicht</a></p>
  </l:main-panel></l:layout>
</j:jelly>
